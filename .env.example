# X (Twitter) Developer API Credentials (OAuth 1.0a User Context)
# Required for publishing and scheduling tweets directly via scripts/x_publisher.js
X_API_KEY=your_consumer_key_here
X_API_KEY_SECRET=your_consumer_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Optional: PulseX Web App Bearer Token (for api.superx.tools & app.superx.so live proxy)
PULSEX_TOKEN=your_pulsex_token_here
